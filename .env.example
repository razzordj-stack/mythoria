# Supabase (öffentlich nutzbare Projektwerte)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Bestehende Supabase-Projekte können alternativ NEXT_PUBLIC_SUPABASE_ANON_KEY verwenden.

# Öffentliche Produktionsdomain; wird für die Supabase-Auth-Konfiguration benötigt
# APP_URL=https://mythoria.example

# Bevorzugter KI-Provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Schutz vor Kosten- und StabilitÃ¤tsproblemen; Werte nur serverseitig verwenden.
AI_DAILY_TURN_LIMIT=40
# Höheres tägliches KI-Limit für aktive Premium-Mitgliedschaften.
AI_PREMIUM_DAILY_TURN_LIMIT=120
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=1
# Optionales OpenAI-Fallback bei temporÃ¤ren Providerfehlern.
OPENAI_FALLBACK_MODEL=

# Optionaler Fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=@preset/mythoria-dungeon-master

# Optional: dediziertes, bestätigtes Testkonto für Playwright-Tests.
# Niemals ein persönliches oder echtes Spielerkonto verwenden.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Stripe Payment Link fuer freiwillige Unterstuetzung (keine geheimen Daten)
NEXT_PUBLIC_STRIPE_SUPPORT_LINK=
# Stripe Premium-Abonnement. Nur serverseitig speichern; niemals als NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Pflichtangaben für Impressum und Datenschutz vor öffentlicher Veröffentlichung
LEGAL_PROVIDER_NAME=
LEGAL_FORM=
LEGAL_REPRESENTATIVE=
LEGAL_STREET=
LEGAL_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_REGISTER=
LEGAL_VAT_ID=
LEGAL_SUPERVISORY_AUTHORITY=
LEGAL_PRIVACY_AUTHORITY=
